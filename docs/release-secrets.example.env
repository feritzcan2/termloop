# GitHub Actions release/deploy secrets
# Copy to a private file like ~/release-secrets.env and fill the values.
#
# After filling, upload with:
# scripts/set-github-actions-secrets.sh --repo feritzcan2/termloop --env-file ~/release-secrets.env

# Sparkle signing private key
# How to get it:
#   cd /Users/example/Projects/termloop-workspace/.cmux-worktrees/deployment/termloop
#   ./scripts/sparkle_generate_keys.sh
# Then read SPARKLE_PRIVATE_KEY from:
#   /Users/example/Projects/termloop-workspace/.cmux-worktrees/deployment/termloop/.env
SPARKLE_PRIVATE_KEY=

# Exported .p12 certificate, base64 encoded onto one line
# How to get it:
#   1. Open Keychain Access
#   2. Find "Developer ID Application: ..."
#   3. Export as .p12 with password
#   4. Run: base64 -i /path/to/cert.p12 | tr -d '\n'
APPLE_CERTIFICATE_BASE64=

# Password you set while exporting the .p12 file from Keychain Access
APPLE_CERTIFICATE_PASSWORD=

# Exact signing identity name from:
#   security find-identity -v -p codesigning
# Example:
#   Developer ID Application: Your Name (TEAMID)
APPLE_SIGNING_IDENTITY=

# Apple account email used for notarization
APPLE_ID=

# Apple app-specific password from:
#   https://account.apple.com/account/manage
# Path:
#   Sign-In and Security -> App-Specific Passwords
APPLE_APP_SPECIFIC_PASSWORD=

# Apple Developer Team ID from:
#   https://developer.apple.com/account
# or Apple Developer membership page
APPLE_TEAM_ID=

# Cloudflare R2 API token pair from:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# Cloudflare account ID for the same account that owns Pages/R2
# Find it in Cloudflare dashboard URL or right sidebar on account overview/pages
CF_R2_ACCOUNT_ID=

# Cloudflare API token for Pages deploy
# Minimal permission:
#   Account -> Cloudflare Pages -> Edit
# Create at:
#   Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID
# Usually same value as CF_R2_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=

# Optional: Sentry auth token if you want dSYM uploads
# Create in Sentry organization settings if used
SENTRY_AUTH_TOKEN=
