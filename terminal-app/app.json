{
  "expo": {
    "name": "TermLoop Mobile",
    "slug": "termloop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "termloop-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.termloop.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "TermLoop Mobile uses the camera to scan pairing QR codes shown by TermLoop on your Mac.",
        "NSLocalNetworkUsageDescription": "TermLoop Mobile connects to TermLoop on your Mac over your local network or Tailscale.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.termloop.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/with-apns-entitlement",
      [
        "expo-camera",
        {
          "cameraPermission": "TermLoop Mobile uses the camera to scan pairing QR codes shown by TermLoop on your Mac."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080D"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "853cde14-00f1-446b-bd84-410e70663a8e"
      }
    },
    "owner": "feritzcan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/853cde14-00f1-446b-bd84-410e70663a8e"
    }
  }
}
