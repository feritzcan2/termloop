{
  "name": "@termloop/desktop",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @termloop/contract build && node build.mjs",
    "start": "pnpm build && electron .",
    "check": "tsc --noEmit",
    "test": "pnpm build && vitest run && electron . --smoke",
    "smoke": "pnpm build && electron . --smoke",
    "native:ghostty": "node-gyp rebuild --directory native/ghostty-host --target=43.3.0 --dist-url=https://electronjs.org/headers",
    "native:ghostty:dev": "node native/ghostty-host/build-dev.mjs",
    "native:ghostty:universal": "node native/ghostty-host/build-universal.mjs",
    "package:dir": "node ../../tools/skills-manager/fetch-cli.mjs --output ../../target/release/skills-manager-cli && pnpm build && electron-builder --dir --config electron-builder.yml",
    "package": "node ../../tools/skills-manager/fetch-cli.mjs --output ../../target/release/skills-manager-cli && pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@termloop/contract": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.1.1",
    "ws": "8.21.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "node-addon-api": "8.9.2",
    "node-gyp": "12.4.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "description": "TermLoop Next desktop client",
  "homepage": "https://github.com/feritzcan2/termloop",
  "author": "Ferit özcan"
}
