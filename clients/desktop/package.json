{
  "name": "@termloop/desktop",
  "version": "2.0.7",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @termloop/ghostty-host build && pnpm --filter @termloop/terminal-wire build && pnpm --filter @termloop/terminal-surface build && pnpm --filter @termloop/contract build && node build.mjs",
    "start": "pnpm build && electron .",
    "check": "pnpm --filter @termloop/ghostty-host build && pnpm --filter @termloop/terminal-wire build && pnpm --filter @termloop/terminal-surface build && tsc --noEmit",
    "test": "pnpm --filter @termloop/ghostty-host test && pnpm build && vitest run && electron . --smoke",
    "smoke": "pnpm build && electron . --smoke",
    "native:ghostty": "pnpm --filter @termloop/ghostty-host native:dev",
    "native:ghostty:dev": "pnpm --filter @termloop/ghostty-host native:dev",
    "native:ghostty:universal": "pnpm --filter @termloop/ghostty-host native:universal",
    "package:dir": "node ../../tools/skills-manager/fetch-cli.mjs --output ../../target/release/skills-manager-cli && pnpm build && electron-builder --dir --config electron-builder.yml",
    "package": "node ../../tools/skills-manager/fetch-cli.mjs --output ../../target/release/skills-manager-cli && pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@react-symbols/icons": "1.4.1",
    "@termloop/contract": "workspace:*",
    "@termloop/terminal-surface": "workspace:*",
    "electron-updater": "6.8.9",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.1.1",
    "shiki": "4.4.3",
    "ws": "8.21.2",
    "zustand": "5.0.8",
    "@termloop/terminal-wire": "workspace:*",
    "@termloop/ghostty-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "ssh2": "1.17.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "description": "TermLoop Next desktop client",
  "homepage": "https://github.com/feritzcan2/termloop",
  "author": "Ferit \u00f6zcan"
}
