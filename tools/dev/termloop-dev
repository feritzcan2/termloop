      "$checkout/clients/desktop/native/ghostty-host/build/Release/ghostty_host.node" \
      "$checkout/vendor/ghostty/zig-out/lib/libghostty.dylib" \
      "$checkout/vendor/ghostty/zig-out/share/ghostty"; do
      if [[ ! -e "$artifact" ]]; then
