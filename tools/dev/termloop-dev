activate_desktop_window() {
  local pid="$1"
  osascript - "$pid" <<'APPLESCRIPT' >/dev/null
on run argv
  set targetPid to item 1 of argv as integer
  tell application "System Events"
    set matches to every process whose unix id is targetPid
    if (count of matches) is 0 then error "desktop process is unavailable"
    set targetProcess to item 1 of matches
    if (count of windows of targetProcess) is 0 then error "desktop window is unavailable"
    repeat 30 times
      try
        perform action "AXRaise" of window 1 of targetProcess
      end try
      set frontmost of targetProcess to true
      delay 0.1
      if frontmost of targetProcess is true then return
    end repeat
    error "desktop activation failed"
  end tell
end run
APPLESCRIPT
}

activate_desktop_window_linux() {
  local pid="$1"
  local window_id
  if command -v wmctrl >/dev/null 2>&1; then
    window_id="$(wmctrl -lp 2>/dev/null | awk -v pid="$pid" '$3 == pid { print $1; exit }')"
    if [[ -n "$window_id" ]] && wmctrl -ia "$window_id" >/dev/null 2>&1; then
      return 0
    fi
  fi
  if command -v xdotool >/dev/null 2>&1; then
    if xdotool search --pid "$pid" windowactivate >/dev/null 2>&1; then
      return 0
    fi
  fi
  return 1
}

archive_invalid_record() {
  local record="$1"
  if [[ -e "$record" && -z "$(read_owned_pid "$record" || true)" ]]; then
    archive_process_record "$record"
  fi
}

prepare_private_log() {
  local log_file="$1"
  if [[ -L "$log_file" ]]; then
    echo "Refusing symlinked profile log: $log_file" >&2
    return 1
  fi
  rm -f "${log_file}.previous"
  if [[ -f "$log_file" ]]; then
    mv "$log_file" "${log_file}.previous"
    chmod 600 "${log_file}.previous"
  fi
  : > "$log_file"
  chmod 600 "$log_file"
}

write_launch_manifest() {
  local artifacts=(
    "$source_server_binary"
    "$source_companion_binary"
    "$source_skills_manager_binary"
    "$checkout/clients/desktop/dist/main.js"
    "$checkout/contract/generated/typescript/dist/current.js"
    "$supervisor_script"
    "$bundle_stager"
    "$skills_manager_fetcher"
  )
  [[ -z "$source_bootstrap_entry" ]] || artifacts+=(
    "$source_bootstrap_entry"
  )
  python3 - "$launch_manifest" "$checkout" "${artifacts[@]}" <<'PY'
import hashlib
import json
import os
import sys

output, checkout, *artifacts = sys.argv[1:]
value = {"version": 1, "checkout": checkout, "artifacts": {}}
for artifact in artifacts:
    with open(artifact, "rb") as source:
        digest = hashlib.sha256(source.read()).hexdigest()
    value["artifacts"][artifact] = {"sha256": digest, "size": os.path.getsize(artifact)}
temporary = output + ".tmp"
with open(temporary, "w") as destination:
    json.dump(value, destination, sort_keys=True, separators=(",", ":"))
    destination.write("\n")
os.chmod(temporary, 0o600)
os.replace(temporary, output)
PY
}

prepare_dev_project() {
  [[ -n "$dev_project_dir" ]] || return 0
  if [[ -L "$dev_project_dir" ]]; then
    echo "Refusing symlinked development Project path: $dev_project_dir" >&2
    return 1
  fi
  mkdir -p "$dev_project_dir"
  if git -C "$dev_project_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local repository_root
    repository_root="$(git -C "$dev_project_dir" rev-parse --show-toplevel)"
    repository_root="$(cd "$repository_root" && pwd -P)"
    if [[ "$repository_root" != "$(cd "$dev_project_dir" && pwd -P)" ]]; then
      echo "Development Project path belongs to another Git repository: $dev_project_dir" >&2
      return 1
    fi
  else
    if [[ -n "$(ls -A "$dev_project_dir")" ]]; then
      echo "Development Project path is non-empty and is not a Git repository: $dev_project_dir" >&2
      return 1
    fi
    git init --quiet --initial-branch=main "$dev_project_dir"
  fi
  if ! git -C "$dev_project_dir" rev-parse --verify HEAD >/dev/null 2>&1; then
    git -C "$dev_project_dir" \
      -c user.name="TermLoop Dev" \
      -c user.email="dev@termloop.local" \
      -c commit.gpgSign=false \
      commit --quiet --allow-empty -m "Initialize development sandbox"
  fi
}

launch_manifest_status() {
  python3 - "$launch_manifest" 2>/dev/null <<'PY' || true
import hashlib
import json
import os
import sys

try:
    with open(sys.argv[1]) as source:
        value = json.load(source)
    if value.get("version") != 1 or not value.get("artifacts"):
        raise ValueError()
    for artifact, expected in value["artifacts"].items():
        with open(artifact, "rb") as source:
            digest = hashlib.sha256(source.read()).hexdigest()
        if digest != expected.get("sha256") or os.path.getsize(artifact) != expected.get("size"):
            print("drifted")
            break
    else:
        print("current")
except Exception:
    print("unavailable")
PY
}

launch_bundle_status() {
  python3 - "$launch_bundle_record" "$profile_root" 2>/dev/null <<'PY' || true
import json
import os
import pathlib
import sys

record = pathlib.Path(sys.argv[1])
profile_root = pathlib.Path(sys.argv[2]).resolve()
try:
    lines = record.read_text().splitlines()
    if len(lines) != 1:
        raise ValueError()
    bundle = pathlib.Path(lines[0]).resolve(strict=True)
    if bundle.parent != profile_root / "launches" or bundle.name != "current":
        raise ValueError()
    manifest = json.loads((bundle / "launch-bundle.json").read_text())
    if manifest.get("version") != 1 or not manifest.get("artifacts"):
        raise ValueError()
    for relative in (
        "target/debug/termloop-server",
        "target/debug/termloop-companion",
        "target/debug/skills-manager-cli",
        "clients/desktop/dist/main.js",
        "clients/desktop/native/ghostty-host/build/Release/ghostty_host.node",
    ):
        candidate = bundle / relative
        if candidate.is_symlink() or not candidate.is_file():
            raise ValueError()
    print("pinned")
except Exception:
    print("unavailable")
PY
}

stop_profile() {
  local stop_mode="${1:-graceful}"
  if [[ "$stop_mode" == "force" ]]; then
    if supervisor_job_loaded; then
      if supervisor_job_running; then
        # Give the daemon one short chance to snapshot its bounded Agent
        # restart handoff before forcefully retiring the exact process tree.
        # This avoids turning an ordinary restart into crash recovery while
        # keeping restart latency bounded when shutdown is wedged.
        if [[ "$launcher_os" == "Darwin" ]]; then
          launchctl kill SIGTERM "$launchd_target" >/dev/null 2>&1 || true
        else
          systemctl --user kill --kill-who=main --signal=TERM "$systemd_unit_name" >/dev/null 2>&1 || true
        fi
        for _attempt in {1..20}; do
          [[ ! -e "$runtime_dir/agent-restart-handoff.json" ]] || break
          sleep 0.05
        done
        if supervisor_job_running; then
          if [[ "$launcher_os" == "Darwin" ]]; then
            launchctl kill SIGKILL "$launchd_target" >/dev/null 2>&1 || true
          else
            systemctl --user kill --kill-who=all --signal=KILL "$systemd_unit_name" >/dev/null 2>&1 || true
          fi
        fi
      fi
      if [[ "$launcher_os" == "Darwin" ]]; then
        launchctl bootout "$launchd_target" >/dev/null 2>&1 || true
      else
        systemctl --user stop "$systemd_unit_name" >/dev/null 2>&1 || true
        systemctl --user disable "$systemd_unit_name" >/dev/null 2>&1 || true
        rm -f "$systemd_unit_file"
        systemctl --user daemon-reload >/dev/null 2>&1 || true
        systemctl --user reset-failed "$systemd_unit_name" >/dev/null 2>&1 || true
      fi
    fi
    force_stop_recorded_process "$desktop_record"
    force_stop_recorded_process "$daemon_record"
    if supervisor_job_loaded || [[ -n "$(read_owned_pid "$daemon_record" || true)" || -n "$(read_owned_pid "$desktop_record" || true)" ]]; then
      echo "TermLoop $supervision_label or an exact owned process remained after force stop." >&2
      return 1
    fi
    archive_invalid_record "$desktop_record"
    archive_invalid_record "$daemon_record"
    return 0
  fi
  if supervisor_job_loaded; then
    if supervisor_job_running; then
      # Signal the exact supervisor before bootout/stop so its daemon child
      # retains the pre-existing 180-second graceful shutdown window. launchd
      # clamps a job's ExitTimeOut to 60 seconds and the systemd unit carries
      # TimeoutStopSec=60, so bootout/stop alone cannot provide this window.
      if [[ "$launcher_os" == "Darwin" ]]; then
        launchctl kill SIGTERM "$launchd_target"
      else
        systemctl --user kill --kill-who=main --signal=TERM "$systemd_unit_name" >/dev/null 2>&1 || true
      fi
    fi
    for _attempt in {1..1850}; do
      local daemon_pid desktop_pid
      daemon_pid="$(read_owned_pid "$daemon_record" || true)"
      desktop_pid="$(read_owned_pid "$desktop_record" || true)"
      if ! supervisor_job_running && [[ -z "$daemon_pid" && -z "$desktop_pid" ]]; then
        break
      fi
      sleep 0.1
    done
    if [[ "$launcher_os" == "Darwin" ]]; then
      launchctl bootout "$launchd_target" >/dev/null 2>&1 || true
    else
      systemctl --user stop "$systemd_unit_name" >/dev/null 2>&1 || true
      systemctl --user disable "$systemd_unit_name" >/dev/null 2>&1 || true
      rm -f "$systemd_unit_file"
      systemctl --user daemon-reload >/dev/null 2>&1 || true
      systemctl --user reset-failed "$systemd_unit_name" >/dev/null 2>&1 || true
    fi
    for _attempt in {1..2000}; do
      daemon_pid="$(read_owned_pid "$daemon_record" || true)"
      desktop_pid="$(read_owned_pid "$desktop_record" || true)"
      if ! supervisor_job_loaded && [[ -z "$daemon_pid" && -z "$desktop_pid" ]]; then
        break
      fi
      sleep 0.1
    done
    if supervisor_job_loaded || [[ -n "$(read_owned_pid "$daemon_record" || true)" || -n "$(read_owned_pid "$desktop_record" || true)" ]]; then
      echo "TermLoop $supervision_label or an exact owned process remained after stop." >&2
      return 1
    fi
    archive_invalid_record "$desktop_record"
    archive_invalid_record "$daemon_record"
    return 0
  fi
  # Only a profile without a rendered launch artifact may use the revision-2
  # direct-PID migration path. A transient launchctl/systemctl probe must never
  # cause a supervised process tree to be managed as a legacy profile.
  if [[ -e "$launch_artifact" ]]; then
    if [[ -n "$(read_owned_pid "$daemon_record" || true)" || -n "$(read_owned_pid "$desktop_record" || true)" ]]; then
      echo "$supervision_label state could not be confirmed; refusing legacy process management for profile $profile." >&2
      return 1
    fi
    archive_invalid_record "$desktop_record"
    archive_invalid_record "$daemon_record"
    return 0
  fi
  # Migration path for profiles started by revision 2 before launchd ownership.
  stop_recorded_process "$desktop_record"
  stop_recorded_process "$daemon_record"
}

show_status() {
  local daemon_pid desktop_pid supervisor_status build_status runtime_status
  daemon_pid="$(read_owned_pid "$daemon_record" || true)"
  desktop_pid="$(read_owned_pid "$desktop_record" || true)"
  supervisor_status="stopped"
  if supervisor_job_loaded; then
    supervisor_status="exited"
    supervisor_job_running && supervisor_status="starting"
    if [[ -n "$daemon_pid" && -n "$desktop_pid" && "$(desktop_ready_pid)" == "$desktop_pid" ]]; then
      supervisor_status="ready"
    fi
  elif [[ -n "$daemon_pid" || -n "$desktop_pid" ]]; then
    supervisor_status="legacy"
  fi
  build_status="$(launch_manifest_status)"
  runtime_status="$(launch_bundle_status)"
  echo "Profile: $profile"
  echo "Checkout: $checkout"
  echo "State: $state_dir"
  echo "Supervisor: $supervisor_status"
  echo "Runtime: ${runtime_status:-unavailable}"
  echo "Build: ${build_status:-unavailable}"
  echo "Daemon: ${daemon_pid:-stopped}"
  echo "Desktop: ${desktop_pid:-stopped}"
}

if [[ "$action" == "status" ]]; then
  show_status
  exit 0
fi
if [[ "$action" == "stop" || "$action" == "stop-profile" ]]; then
  stop_profile
  show_status
  exit 0
fi
if [[ "$action" == "start" ]]; then
  existing_daemon="$(read_owned_pid "$daemon_record" || true)"
  existing_desktop="$(read_owned_pid "$desktop_record" || true)"
  if supervisor_job_loaded && ! supervisor_job_running && [[ -z "$existing_daemon" && -z "$existing_desktop" ]]; then
    stop_profile
  elif supervisor_job_loaded || [[ -n "$existing_daemon" || -n "$existing_desktop" ]]; then
    echo "Profile $profile is already running; use restart." >&2
    show_status >&2
    exit 1
  fi
fi

if [[ "$launcher_os" != "Darwin" && "$launcher_os" != "Linux" ]]; then
  echo "Persistent development supervision is supported on macOS and Linux only; refusing an unsupervised start." >&2
  exit 1
fi
if [[ "$launcher_os" == "Linux" ]] && ! systemd_user_manager_available; then
  echo "systemd user manager is unavailable: 'systemctl --user' must work, which requires a systemd user session with XDG_RUNTIME_DIR and its session D-Bus; refusing an unsupervised start." >&2
  exit 1
fi

mkdir -p "$state_dir" "$runtime_dir" "$desktop_dir" "$log_dir" "$(dirname "$desktop_record")"
chmod 700 "$state_dir" "$runtime_dir" "$desktop_dir" "$log_dir" "$(dirname "$desktop_record")"
prepare_dev_project

cd "$checkout"
source_server_binary="$cargo_target_dir/debug/termloop-server"
source_companion_binary="$cargo_target_dir/debug/termloop-companion"
source_skills_manager_binary="$cargo_target_dir/debug/skills-manager-cli"
