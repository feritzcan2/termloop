        exit 1
      fi
    done
  fi
fi
if [[ "$reuse_build" == false ]]; then
  pnpm --filter @termloop/desktop build
else
  for artifact in \
    "$checkout/clients/desktop/dist/main.js" \
    "$checkout/clients/desktop/dist/preload.cjs" \
    "$checkout/clients/desktop/dist/terminal-gateway.js" \
    "$checkout/clients/desktop/dist/renderer.js" \
    "$checkout/clients/desktop/dist/index.html"; do
    if [[ ! -e "$artifact" ]]; then
      echo "Reusable TermLoop desktop artifact is unavailable: $artifact" >&2
      exit 1
    fi
  done
fi

server_binary="$source_server_binary"
companion_binary="$source_companion_binary"
desktop_cwd="$checkout/clients/desktop"
if [[ "$launcher_os" == "Darwin" ]]; then
  if [[ ! -x "$bundle_stager" ]]; then
    echo "TermLoop launch bundle stager is unavailable: $bundle_stager" >&2
    exit 1
  fi
  include_bootstrap=false
  [[ -z "$profile_tag" ]] || include_bootstrap=true
  launch_bundle="$($bundle_stager "$checkout" "$profile_root" "$include_bootstrap" "$cargo_target_dir")"
  server_binary="$launch_bundle/target/debug/termloop-server"
  companion_binary="$launch_bundle/target/debug/termloop-companion"
  desktop_cwd="$launch_bundle/clients/desktop"
  if [[ -n "$source_bootstrap_entry" ]]; then
    bootstrap_entry="$launch_bundle/tools/dev/bootstrap-dev-profile.mjs"
  fi
  for executable in "$server_binary" "$companion_binary" "$launch_bundle/target/debug/skills-manager-cli"; do
    if [[ ! -x "$executable" ]]; then
      echo "Pinned TermLoop executable is unavailable: $executable" >&2
      exit 1
    fi
  done
fi
if [[ -n "$bootstrap_entry" ]]; then
  if [[ ! -f "$bootstrap_entry" || ! -x "$node_binary" ]]; then
    echo "TermLoop tagged-profile bootstrap artifacts are unavailable." >&2
    exit 1
  fi
fi
electron_binary="$(cd "$checkout/clients/desktop" && node -e 'process.stdout.write(require("electron"))')"
python_binary="$(command -v python3)"
if [[ ! -x "$electron_binary" ]]; then
  echo "TermLoop Electron binary was not resolved." >&2
  exit 1
fi
if [[ "$action" == "restart" ]]; then
  stop_profile force
fi
if [[ "$launcher_os" == "Darwin" ]]; then
