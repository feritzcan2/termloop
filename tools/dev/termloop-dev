#!/bin/bash

set -euo pipefail

action="${1:-start}"
if [[ "$action" == "start" || "$action" == "stop" || "$action" == "restart" || "$action" == "status" || "$action" == "list" || "$action" == "stop-profile" || "$action" == "prune" ]]; then
  [[ $# -gt 0 ]] && shift
else
  echo "Usage: tools/dev/termloop-dev {start|stop|restart|status} [--checkout PATH] [--tag FEATURE | --main [--reuse-build] [--allow-agent-main]]" >&2
  echo "       tools/dev/termloop-dev list" >&2
  echo "       tools/dev/termloop-dev stop-profile --profile PROFILE" >&2
  echo "       tools/dev/termloop-dev prune [--profile PROFILE] [--older-than DAYS] [--keep COUNT] [--legacy-builds] [--apply]" >&2
  exit 2
fi

required_commands=(git python3)
if [[ "$action" == "start" || "$action" == "restart" ]]; then
  required_commands+=(cargo pnpm node)
fi
if [[ "$(uname -s)" == "Darwin" ]]; then
  required_commands+=(launchctl osascript)
elif [[ "$(uname -s)" == "Linux" && ("$action" == "start" || "$action" == "restart") ]]; then
  required_commands+=(systemctl)
fi
for command_name in "${required_commands[@]}"; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Required command not found: $command_name" >&2
    exit 1
  fi
done

checkout=""
profile_tag=""
profile_override=""
use_main=false
reuse_build=false
allow_agent_main=false
prune_older_than_days=3
prune_keep_count=2
prune_apply=false
prune_legacy_builds=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --checkout)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "--checkout requires a non-empty path." >&2
        exit 2
      fi
      checkout="${2:-}"
      shift 2
      ;;
    --tag)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "--tag requires a non-empty feature tag." >&2
        exit 2
      fi
      profile_tag="${2:-}"
      shift 2
      ;;
    --main)
      use_main=true
      shift
      ;;
    --reuse-build)
      reuse_build=true
      shift
      ;;
    --allow-agent-main)
      allow_agent_main=true
      shift
      ;;
    --profile)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "--profile requires a non-empty exact profile name." >&2
        exit 2
      fi
      profile_override="$2"
      shift 2
      ;;
    --older-than)
      if [[ "$action" != "prune" || $# -lt 2 || ! "${2:-}" =~ ^[0-9]{1,4}$ ]]; then
        echo "--older-than requires prune and a whole number of days." >&2
        exit 2
      fi
      prune_older_than_days="$2"
      shift 2
      ;;
    --keep)
      if [[ "$action" != "prune" || $# -lt 2 || ! "${2:-}" =~ ^[0-9]{1,4}$ ]]; then
        echo "--keep requires prune and a whole number of profiles." >&2
        exit 2
      fi
      prune_keep_count="$2"
      shift 2
      ;;
    --apply)
      if [[ "$action" != "prune" ]]; then
        echo "--apply is valid only with prune." >&2
        exit 2
      fi
      prune_apply=true
      shift
      ;;
    --legacy-builds)
      if [[ "$action" != "prune" ]]; then
        echo "--legacy-builds is valid only with prune." >&2
        exit 2
      fi
      prune_legacy_builds=true
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

launcher_os="$(uname -s)"

profiles_root_path() {
  if [[ "$launcher_os" == "Darwin" ]]; then
    printf '%s\n' "$HOME/Library/Application Support/termloop-next/profiles"
  else
    printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/termloop-next/profiles"
  fi
}

systemd_unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

systemd_unit_name_for_profile() {
  printf 'termloop-next-dev-%s.service\n' "$1"
}

systemd_user_manager_available() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user show-environment >/dev/null 2>&1
}

systemd_unit_active_state() {
  systemctl --user show --property ActiveState --value "$1" 2>/dev/null || true
}

supervisor_state_for_profile() {
  local candidate_profile="$1"
  local candidate_state="stopped"
  if [[ "$launcher_os" == "Darwin" ]] && launchctl print "gui/$(id -u)/com.termloop.next.dev.$candidate_profile" >/dev/null 2>&1; then
    candidate_state="exited"
    launchctl print "gui/$(id -u)/com.termloop.next.dev.$candidate_profile" 2>/dev/null | \
      awk '$1 == "state" && $2 == "=" { exit($3 == "running" ? 0 : 1) } END { if (NR == 0) exit 1 }' && \
      candidate_state="running"
  elif [[ "$launcher_os" == "Linux" && -f "$systemd_unit_dir/$(systemd_unit_name_for_profile "$candidate_profile")" ]] && systemd_user_manager_available; then
    candidate_state="exited"
    case "$(systemd_unit_active_state "$(systemd_unit_name_for_profile "$candidate_profile")")" in
      active|activating|reloading) candidate_state="running" ;;
    esac
  fi
  printf '%s\n' "$candidate_state"
}

if [[ "$action" == "list" ]]; then
  if [[ -n "$checkout" || -n "$profile_tag" || -n "$profile_override" || "$use_main" == true || "$reuse_build" == true || "$allow_agent_main" == true ]]; then
    echo "list accepts no profile-selection arguments." >&2
    exit 2
  fi
  profiles_root="$(profiles_root_path)"
  echo "PROFILE|SUPERVISOR|CHECKOUT"
  if [[ -d "$profiles_root" ]]; then
    for candidate in "$profiles_root"/*; do
      [[ -d "$candidate" ]] || continue
      candidate_profile="$(basename "$candidate")"
      candidate_checkout="missing"
      [[ ! -f "$candidate/checkout.path" ]] || candidate_checkout="$(sed -n '1p' "$candidate/checkout.path")"
      candidate_state="$(supervisor_state_for_profile "$candidate_profile")"
      printf '%s|%s|%s\n' "$candidate_profile" "$candidate_state" "$candidate_checkout"
    done
  fi
  exit 0
fi

profile_last_use_epoch() {
  python3 - "$1" <<'PY'
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
latest = 0.0
try:
    latest = root.stat().st_mtime
except OSError:
    pass
try:
    entries = list(root.iterdir())
except OSError:
    entries = []
for entry in entries:
    try:
        latest = max(latest, entry.stat().st_mtime)
    except OSError:
        continue
    if entry.is_dir() and not entry.is_symlink() and entry.name in {"runtime", "logs", "state", "desktop"}:
        try:
            children = list(entry.iterdir())
        except OSError:
            continue
        for child in children:
            try:
                latest = max(latest, child.stat().st_mtime)
            except OSError:
                continue
print(int(latest))
PY
}

remove_pruned_directory() {
  local target="$1"
  local leaf="$2"
  local expected_parent="$3"
  local resolved_parent=""
  if [[ ! "$leaf" =~ ^[a-z0-9][a-z0-9._-]{0,80}$ || "$leaf" == "main" ]]; then
    echo "Refusing to delete an unexpected profile leaf: $leaf" >&2
    return 1
  fi
  if [[ -L "$target" || ! -d "$target" ]]; then
    echo "Refusing to delete a non-directory or symlinked profile path: $target" >&2
    return 1
  fi
  resolved_parent="$(cd "$target/.." && pwd -P)"
  if [[ "$resolved_parent" != "$expected_parent" ]]; then
    echo "Refusing to delete outside the profiles root: $target" >&2
    return 1
  fi
  if [[ ! -e "$target/checkout.path" && ! -d "$target/state" && ! -d "$target/runtime" && ! -d "$target/logs" && ! -d "$target/cargo-target" ]]; then
    echo "Refusing to delete a directory without launcher profile leaves: $target" >&2
    return 1
  fi
  rm -rf -- "$target"
}

if [[ "$action" == "prune" ]]; then
  if [[ -n "$checkout" || -n "$profile_tag" || "$use_main" == true || "$reuse_build" == true || "$allow_agent_main" == true ]]; then
    echo "prune accepts only --profile, --older-than, --keep, --legacy-builds, and --apply." >&2
    exit 2
  fi
  if [[ -n "$profile_override" && ! "$profile_override" =~ ^[a-z0-9][a-z0-9._-]{0,80}$ ]]; then
    echo "prune --profile requires an exact generated profile name." >&2
    exit 2
  fi
  if [[ "$profile_override" == "main" ]]; then
    echo "prune never targets the human-owned main profile." >&2
    exit 2
  fi
  profiles_root="$(profiles_root_path)"
  if [[ -L "$profiles_root" ]]; then
    echo "Refusing to prune a symlinked profiles root: $profiles_root" >&2
    exit 1
  fi
  if [[ ! -d "$profiles_root" ]]; then
    echo "PROFILE|SUPERVISOR|IDLE_DAYS|SIZE_MIB|ACTION"
    echo "Reclaimable: 0 MiB across 0 profiles"
    exit 0
  fi
  profiles_root="$(cd "$profiles_root" && pwd -P)"
  launcher_self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  prune_now_epoch="$(date +%s)"
  prune_names=()
  prune_states=()
  prune_idles=()
  prune_sizes=()
  prune_epochs=()
  prune_verdicts=()
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    candidate_profile="$(basename "$candidate")"
    [[ "$candidate_profile" =~ ^[a-z0-9][a-z0-9._-]{0,80}$ ]] || continue
    [[ "$candidate_profile" != "main" ]] || continue
    if [[ -n "$profile_override" && "$candidate_profile" != "$profile_override" ]]; then
      continue
    fi
    candidate_state="$(supervisor_state_for_profile "$candidate_profile")"
    candidate_epoch="$(profile_last_use_epoch "$candidate")"
    candidate_idle=$(( (prune_now_epoch - candidate_epoch) / 86400 ))
    (( candidate_idle >= 0 )) || candidate_idle=0
    candidate_size="$(du -sk "$candidate" 2>/dev/null | awk 'END {print $1 + 0}')"
    if [[ "$candidate_state" == "running" ]]; then
      candidate_verdict="keep:running"
    elif [[ -n "$profile_override" ]]; then
      candidate_verdict="candidate"
    elif (( candidate_idle < prune_older_than_days )); then
      candidate_verdict="keep:recent"
    else
      candidate_verdict="candidate"
    fi
    prune_names+=("$candidate_profile")
    prune_states+=("$candidate_state")
    prune_idles+=("$candidate_idle")
    prune_sizes+=("$candidate_size")
    prune_epochs+=("$candidate_epoch")
    prune_verdicts+=("$candidate_verdict")
  done < <(find "$profiles_root" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort)

  if [[ -z "$profile_override" ]] && (( prune_keep_count > 0 )) && (( ${#prune_names[@]} > 0 )); then
    kept_recent=0
    while IFS='|' read -r _kept_epoch kept_index; do
      [[ -n "$kept_index" ]] || continue
      (( kept_recent < prune_keep_count )) || break
      prune_verdicts[$kept_index]="keep:newest"
      kept_recent=$((kept_recent + 1))
    done < <(
      for index in "${!prune_names[@]}"; do
        if [[ "${prune_verdicts[$index]}" == "candidate" ]]; then
          printf '%s|%s\n' "${prune_epochs[$index]}" "$index"
        fi
      done | sort -t'|' -k1,1nr
    )
  fi

  echo "PROFILE|SUPERVISOR|IDLE_DAYS|SIZE_MIB|ACTION"
  prune_total_kib=0
  prune_target_count=0
  if (( ${#prune_names[@]} > 0 )); then
    for index in "${!prune_names[@]}"; do
      row_action="${prune_verdicts[$index]}"
      [[ "$row_action" != "candidate" ]] || row_action="prune"
      printf '%s|%s|%s|%s|%s\n' \
        "${prune_names[$index]}" "${prune_states[$index]}" "${prune_idles[$index]}" \
        "$(( prune_sizes[index] / 1024 ))" "$row_action"
      if [[ "$row_action" == "prune" ]]; then
        prune_total_kib=$(( prune_total_kib + prune_sizes[index] ))
        prune_target_count=$(( prune_target_count + 1 ))
      fi
    done
  fi

  prune_legacy_paths=()
  if [[ "$prune_legacy_builds" == true ]] && (( ${#prune_names[@]} > 0 )); then
    for index in "${!prune_names[@]}"; do
      case "${prune_verdicts[$index]}" in
        keep:recent|keep:newest) ;;
        *) continue ;;
      esac
      legacy_target="$profiles_root/${prune_names[$index]}/cargo-target"
      if [[ -d "$legacy_target" && ! -L "$legacy_target" ]]; then
        legacy_size="$(du -sk "$legacy_target" 2>/dev/null | awk 'END {print $1 + 0}')"
        printf '%s|%s|%s|%s|%s\n' \
          "${prune_names[$index]}" "${prune_states[$index]}" "${prune_idles[$index]}" \
          "$(( legacy_size / 1024 ))" "legacy-build"
        prune_total_kib=$(( prune_total_kib + legacy_size ))
        prune_legacy_paths+=("$legacy_target")
      fi
    done
  fi

  prune_orphan_labels=()
  prune_orphan_units=()
  if [[ "$launcher_os" == "Darwin" ]]; then
    while IFS= read -r orphan_label; do
      [[ -n "$orphan_label" ]] || continue
      orphan_profile="${orphan_label#com.termloop.next.dev.}"
      [[ "$orphan_profile" != "$orphan_label" ]] || continue
      [[ "$orphan_profile" != "main" ]] || continue
      [[ ! -d "$profiles_root/$orphan_profile" ]] || continue
      [[ "$(supervisor_state_for_profile "$orphan_profile")" != "running" ]] || continue
      if [[ -n "$profile_override" && "$orphan_profile" != "$profile_override" ]]; then
        continue
      fi
      printf '%s|%s|%s|%s|%s\n' "$orphan_profile" "registered" "-" "0" "unregister"
      prune_orphan_labels+=("$orphan_label")
    done < <(launchctl list 2>/dev/null | awk '{print $3}' | grep '^com\.termloop\.next\.dev\.' || true)
  elif [[ "$launcher_os" == "Linux" && -d "$systemd_unit_dir" ]]; then
    while IFS= read -r orphan_unit_path; do
      [[ -n "$orphan_unit_path" ]] || continue
      orphan_unit="$(basename "$orphan_unit_path")"
      orphan_profile="${orphan_unit#termloop-next-dev-}"
      orphan_profile="${orphan_profile%.service}"
      [[ -n "$orphan_profile" && "$orphan_profile" != "main" ]] || continue
      [[ ! -d "$profiles_root/$orphan_profile" ]] || continue
      [[ "$(supervisor_state_for_profile "$orphan_profile")" != "running" ]] || continue
      if [[ -n "$profile_override" && "$orphan_profile" != "$profile_override" ]]; then
        continue
      fi
      printf '%s|%s|%s|%s|%s\n' "$orphan_profile" "registered" "-" "0" "unregister"
      prune_orphan_units+=("$orphan_unit")
    done < <(find "$systemd_unit_dir" -maxdepth 1 -name 'termloop-next-dev-*.service' -print 2>/dev/null | sort)
  fi

  if [[ "$prune_apply" == false ]]; then
    printf 'Reclaimable: %s MiB across %s profiles\n' "$(( prune_total_kib / 1024 ))" "$prune_target_count"
    echo "Preview only. Re-run with --apply to delete."
    exit 0
  fi

  prune_freed_kib=0
  prune_removed_count=0
  if (( ${#prune_names[@]} > 0 )); then
    for index in "${!prune_names[@]}"; do
      [[ "${prune_verdicts[$index]}" == "candidate" ]] || continue
      prune_profile="${prune_names[$index]}"
      "$launcher_self" stop-profile --profile "$prune_profile" >/dev/null 2>&1 || true
      if [[ "$(supervisor_state_for_profile "$prune_profile")" == "running" ]]; then
        echo "Skipped $prune_profile: supervisor is still running." >&2
        continue
      fi
      if remove_pruned_directory "$profiles_root/$prune_profile" "$prune_profile" "$profiles_root"; then
        prune_freed_kib=$(( prune_freed_kib + prune_sizes[index] ))
        prune_removed_count=$(( prune_removed_count + 1 ))
      fi
    done
  fi
  if (( ${#prune_legacy_paths[@]} > 0 )); then
    for legacy_target in "${prune_legacy_paths[@]}"; do
      legacy_size="$(du -sk "$legacy_target" 2>/dev/null | awk 'END {print $1 + 0}')"
      if [[ -d "$legacy_target" && ! -L "$legacy_target" && "$(basename "$legacy_target")" == "cargo-target" ]]; then
        rm -rf -- "$legacy_target"
        prune_freed_kib=$(( prune_freed_kib + legacy_size ))
      fi
    done
  fi
  if (( ${#prune_orphan_labels[@]} > 0 )); then
    for orphan_label in "${prune_orphan_labels[@]}"; do
      launchctl bootout "gui/$(id -u)/$orphan_label" >/dev/null 2>&1 || true
    done
  fi
  if (( ${#prune_orphan_units[@]} > 0 )); then
    for orphan_unit in "${prune_orphan_units[@]}"; do
      systemctl --user disable --now "$orphan_unit" >/dev/null 2>&1 || true
      rm -f -- "$systemd_unit_dir/$orphan_unit"
    done
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
  printf 'Freed: %s MiB across %s profiles\n' "$(( prune_freed_kib / 1024 ))" "$prune_removed_count"
  exit 0
fi

explicit_profile=false
if [[ "$action" == "stop-profile" ]]; then
  if [[ ! "$profile_override" =~ ^[a-z0-9][a-z0-9._-]{0,80}$ || -n "$checkout" || -n "$profile_tag" || "$use_main" == true || "$reuse_build" == true || "$allow_agent_main" == true ]]; then
    echo "stop-profile requires only --profile with an exact generated profile name." >&2
    exit 2
  fi
  explicit_profile=true
  profile="$profile_override"
  profile_root="$(profiles_root_path)/$profile"
  checkout="missing"
  [[ ! -f "$profile_root/checkout.path" ]] || checkout="$(sed -n '1p' "$profile_root/checkout.path")"
fi

if [[ "$explicit_profile" == false ]]; then
  checkout="${checkout:-$(pwd -P)}"
  checkout="$(cd "$checkout" && pwd -P)"
  checkout="$(git -C "$checkout" rev-parse --show-toplevel)"
  checkout="$(cd "$checkout" && pwd -P)"
fi

if [[ "$use_main" == true && -n "$profile_tag" ]]; then
  echo "--main and --tag cannot be used together." >&2
  exit 2
fi
if [[ "$reuse_build" == true && ("$use_main" == false || ("$action" != "start" && "$action" != "restart")) ]]; then
  echo "--reuse-build is valid only with start/restart --main." >&2
  exit 2
fi
if [[ "$allow_agent_main" == true && ("$use_main" == false || ("$action" != "start" && "$action" != "restart")) ]]; then
  echo "--allow-agent-main is valid only with start/restart --main." >&2
  exit 2
fi
if [[ "$use_main" == true && ! -d "$checkout/.git" ]]; then
  echo "--main is valid only for the primary checkout: $checkout" >&2
  exit 2
fi
if [[ ("$action" == "start" || "$action" == "restart") && "$use_main" == false && -z "$profile_tag" ]]; then
  echo "Persistent start/restart requires --tag FEATURE. Use --main only for the human-owned primary app." >&2
  exit 2
fi
if [[ ("$action" == "start" || "$action" == "restart") && "$use_main" == true && "$allow_agent_main" == false \
  && (-n "${CODEX_THREAD_ID:-}" || -n "${CLAUDECODE:-}" || -n "${TERMLOOP_MCP_TOKEN:-}") ]]; then
  echo "Refusing to start the human-owned main profile from an agent environment." >&2
  echo "Use a tagged profile, or pass --allow-agent-main only when the user explicitly requested main-profile operation." >&2
  exit 2
fi

if [[ "$explicit_profile" == true ]]; then
  state_dir="$profile_root/state"
  runtime_dir="$profile_root/runtime"
  desktop_dir="$profile_root/desktop"
  log_dir="$profile_root/logs"
elif [[ "$use_main" == true || (-z "$profile_tag" && -d "$checkout/.git") ]]; then
  profile="main"
  if [[ "$launcher_os" == "Darwin" ]]; then
    profile_root="$HOME/Library/Application Support/termloop-next"
    state_dir="$profile_root"
    runtime_dir="$profile_root"
    desktop_dir="$HOME/Library/Application Support/@termloop/desktop"
    log_dir="$HOME/Library/Logs/TermLoop Next/main"
  else
    profile_root="${XDG_STATE_HOME:-$HOME/.local/state}/termloop-next"
    state_dir="$profile_root"
    if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
      runtime_dir="$XDG_RUNTIME_DIR/termloop-next"
    else
      runtime_dir="${TMPDIR:-/tmp}/termloop-next-$(id -u)/termloop-next"
    fi
    desktop_dir="${XDG_CONFIG_HOME:-$HOME/.config}/@termloop/desktop"
    log_dir="$profile_root/logs/main"
  fi
else
  profile="$(python3 - "$checkout" "$profile_tag" <<'PY'
import pathlib
import re
import sys

checkout = pathlib.Path(sys.argv[1])
requested = sys.argv[2]
if requested:
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,47}', requested):
        raise SystemExit('Feature tag must match [A-Za-z0-9][A-Za-z0-9._-]{0,47}')
    label = requested.lower()
else:
    label = ''.join(c.lower() if c.isascii() and (c.isalnum() or c in '-_') else '-' for c in checkout.name).strip('-') or 'checkout'
value = 0xcbf29ce484222325
for byte in str(checkout).encode():
    value = ((value ^ byte) * 0x100000001b3) & 0xffffffffffffffff
print(f"{label}-{value:016x}")
PY
)"
  profile_root="$(profiles_root_path)/$profile"
  state_dir="$profile_root/state"
  runtime_dir="$profile_root/runtime"
  desktop_dir="$profile_root/desktop"
  log_dir="$profile_root/logs"
fi

runtime_file="$runtime_dir/runtime.json"
daemon_record="$runtime_dir/daemon-owner/current.process"
desktop_record="$runtime_dir/desktop-owner/current.process"
server_log="$log_dir/server.log"
desktop_log="$log_dir/desktop.log"
supervisor_log="$log_dir/supervisor.log"
desktop_ready_file="$runtime_dir/desktop.ready.json"
supervisor_script="$checkout/tools/dev/termloop-dev-supervisor"
launch_agent_plist="$runtime_dir/dev-launch-agent.plist"
launch_manifest="$runtime_dir/dev-launch-manifest.json"
launch_bundle_record="$runtime_dir/dev-launch-bundle.path"
checkout_record="$profile_root/checkout.path"
launchd_label="com.termloop.next.dev.$profile"
launchd_domain="gui/$(id -u)"
launchd_target="$launchd_domain/$launchd_label"
bundle_stager="$checkout/tools/dev/stage-termloop-launch-bundle"
skills_manager_fetcher="$checkout/tools/skills-manager/fetch-cli.mjs"
systemd_unit_name="$(systemd_unit_name_for_profile "$profile")"
systemd_unit_file="$systemd_unit_dir/$systemd_unit_name"
if [[ "$launcher_os" == "Darwin" ]]; then
  supervision_label="LaunchAgent"
  launch_artifact="$launch_agent_plist"
else
  supervision_label="systemd unit"
  launch_artifact="$systemd_unit_file"
fi
dev_project_name=""
dev_project_dir=""
dev_task_title=""
bootstrap_entry=""
source_bootstrap_entry=""
node_binary=""

if [[ -n "$profile_tag" ]]; then
  dev_project_name="TermLoop Dev Sandbox"
  dev_project_dir="$HOME/Projects/termloop-dev-sandbox"
  dev_task_title="Sandbox Task"
  source_bootstrap_entry="$checkout/tools/dev/bootstrap-dev-profile.mjs"
  bootstrap_entry="$source_bootstrap_entry"
  node_binary="$(command -v node)"
fi

export TERMLOOP_RUNTIME_DIR="$runtime_dir"
export TERMLOOP_STATE_DIR="$state_dir"
export TERMLOOP_RUNTIME_FILE="$runtime_file"
export TERMLOOP_DESKTOP_USER_DATA_DIR="$desktop_dir"
export TERMLOOP_DEV_PROFILE_TAG="$profile_tag"

if [[ -n "$profile_tag" ]]; then
  # Tagged profiles of one checkout build byte-identical binaries, so they share a
  # single Cargo target directory. It stays outside the developer's target/debug so
  # a profile build never invalidates the primary checkout's warm artifacts, and it
  # replaces the retired per-profile cargo-target that cost a full cold build and
  # roughly two gigabytes for every new tag.
  cargo_target_dir="$checkout/target/dev-profiles"
else
  cargo_target_dir="$checkout/target"
fi

process_identity() {
  local pid="$1"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    ps -p "$pid" -o state= -o lstart= 2>/dev/null | python3 -c '
import sys
parts = sys.stdin.read().split()
if parts and not parts[0].startswith("Z") and len(parts) > 1:
    print("unix:" + " ".join(parts[1:]))
' || true
    return
  fi
  if [[ "$launcher_os" == "Linux" && -r "/proc/$pid/stat" ]]; then
    python3 - "$pid" <<'PY'
import pathlib
import sys

value = pathlib.Path(f"/proc/{sys.argv[1]}/stat").read_text()
suffix = value.rsplit(')', 1)[1].split()
if suffix[0] != 'Z':
    print(f"linux:{suffix[19]}")
PY
    return
  fi
  return 1
}

read_owned_process() {
  local record="$1"
  [[ -f "$record" ]] || return 1
  local version pid identity extra
  { read -r version; read -r pid; read -r identity; read -r extra || true; } < "$record"
  [[ "$version" == "v1" && "$pid" =~ ^[0-9]+$ && -n "$identity" && -z "$extra" ]] || return 1
  [[ "$(process_identity "$pid" || true)" == "$identity" ]] || return 1
  printf '%s\n%s\n' "$pid" "$identity"
}

read_owned_pid() {
  local owned
  owned="$(read_owned_process "$1")" || return 1
  printf '%s\n' "${owned%%$'\n'*}"
}

archive_process_record() {
  local record="$1"
  if [[ -e "$record" ]]; then
    mv -f "$record" "$record.stale"
  fi
}

discovery_pid() {
  python3 - "$runtime_file" 2>/dev/null <<'PY' || true
import json
import sys

with open(sys.argv[1]) as source:
    print(json.load(source).get("pid", ""))
PY
}

descendant_pids() {
  python3 - "$1" <<'PY' || true
import subprocess
import sys

root = int(sys.argv[1])
rows = subprocess.check_output(["ps", "-axo", "pid=,ppid="], text=True).splitlines()
children = {}
for row in rows:
    pid, parent = map(int, row.split())
    children.setdefault(parent, []).append(pid)
result = []
def visit(parent):
    for child in children.get(parent, []):
        visit(child)
        result.append(child)
visit(root)
print(" ".join(map(str, result)))
PY
}

stop_recorded_process() {
  local record="$1"
  local owned pid expected_identity
  owned="$(read_owned_process "$record" || true)"
  if [[ -z "$owned" ]]; then
    archive_process_record "$record"
    return 0
  fi
  pid="${owned%%$'\n'*}"
  expected_identity="${owned#*$'\n'}"
  local descendants
  descendants="$(descendant_pids "$pid")"
  if [[ "$record" != "$daemon_record" && -n "$descendants" ]]; then
    # shellcheck disable=SC2086
    kill -TERM $descendants 2>/dev/null || true
  fi
  kill -TERM "$pid" 2>/dev/null || true
  local attempts=50
  [[ "$record" == "$daemon_record" ]] && attempts=1800
  for ((_attempt = 1; _attempt <= attempts; _attempt++)); do
    if [[ "$(process_identity "$pid" || true)" != "$expected_identity" ]]; then
      archive_process_record "$record"
      return 0
    fi
    sleep 0.1
  done
  if [[ -n "$descendants" ]]; then
    # shellcheck disable=SC2086
    kill -KILL $descendants 2>/dev/null || true
  fi
  kill -KILL "$pid" 2>/dev/null || true
  archive_process_record "$record"
}

force_stop_recorded_process() {
  local record="$1"
  local owned pid expected_identity descendants
  owned="$(read_owned_process "$record" || true)"
  if [[ -z "$owned" ]]; then
    archive_process_record "$record"
    return 0
  fi
  pid="${owned%%$'\n'*}"
  expected_identity="${owned#*$'\n'}"
  descendants="$(descendant_pids "$pid")"
  if [[ -n "$descendants" ]]; then
    # shellcheck disable=SC2086
    kill -KILL $descendants 2>/dev/null || true
  fi
  kill -KILL "$pid" 2>/dev/null || true
  # launchd-owned processes can remain observable after SIGKILL while macOS
  # tears down their process group and unloads the job. Keep the exact identity
  # fence, but allow a bounded ten-second reap window before reporting failure.
  for _attempt in {1..500}; do
    if [[ "$(process_identity "$pid" || true)" != "$expected_identity" ]]; then
      archive_process_record "$record"
      return 0
    fi
    sleep 0.02
  done
  echo "Exact owned process $pid remained after force stop." >&2
  return 1
}

launchd_job_loaded() {
  [[ "$(uname -s)" == "Darwin" ]] || return 1
  local attempt
  for attempt in 1 2 3; do
    if launchctl print "$launchd_target" >/dev/null 2>&1; then
      return 0
    fi
    [[ "$attempt" == "3" ]] || sleep 0.05
  done
  return 1
}

launchd_job_running() {
  launchctl print "$launchd_target" 2>/dev/null | awk '
    $1 == "state" && $2 == "=" { exit($3 == "running" ? 0 : 1) }
    END { if (NR == 0) exit 1 }
  '
}

systemd_job_loaded() {
  [[ "$launcher_os" == "Linux" ]] || return 1
  [[ -f "$systemd_unit_file" ]] || return 1
  systemd_user_manager_available
}

systemd_job_running() {
  case "$(systemd_unit_active_state "$systemd_unit_name")" in
    active|activating|reloading) return 0 ;;
  esac
  return 1
}

supervisor_job_loaded() {
  if [[ "$launcher_os" == "Darwin" ]]; then
    launchd_job_loaded
  else
    systemd_job_loaded
  fi
}

supervisor_job_running() {
  if [[ "$launcher_os" == "Darwin" ]]; then
    launchd_job_running
  else
    systemd_job_running
  fi
}

