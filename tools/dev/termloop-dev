fi
for executable in "$source_server_binary" "$source_companion_binary" "$source_skills_manager_binary"; do
  if [[ ! -x "$executable" ]]; then
    echo "Reusable TermLoop executable is unavailable: $executable" >&2
    exit 1
  fi
done
if [[ "$reuse_build" == true ]]; then
  echo "Reusing existing main build artifacts."
fi

if [[ ! -x "$supervisor_script" ]]; then
  echo "TermLoop development supervisor is not executable." >&2
  exit 1
fi
if [[ "$launcher_os" == "Darwin" ]]; then
  if [[ "$reuse_build" == false ]]; then
    if [[ ! -x "$checkout/clients/desktop/node_modules/.bin/node-gyp" || \
          ! -e "$checkout/clients/desktop/node_modules/node-addon-api" ]]; then
      pnpm install --frozen-lockfile
